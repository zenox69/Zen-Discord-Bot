# ============================================================
# Zen Marketplace Bot — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Discord -------------------------------------------------
# Bot token from the Discord Developer Portal (Bot page).
DISCORD_TOKEN=

# Application ID from the Developer Portal (General Information page).
DISCORD_CLIENT_ID=

# Optional: register slash commands to a single guild instantly.
# Leave empty to register commands globally (can take up to ~1 hour to propagate).
GUILD_ID=

# --- Database (PostgreSQL) -----------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/zenmarketplace?schema=public

# --- App ------------------------------------------------------
# development | production
NODE_ENV=development

# --- Background job schedules (cron expressions) --------------
# Announce newly-eligible members (every 6 hours by default).
CRON_ELIGIBILITY_NOTIFIER=0 */6 * * *
# Re-check Roblox group memberships for all tracked members (every 30 min).
CRON_MEMBERSHIP_REFRESH=*/30 * * * *
# Expire stale pending verifications (every 5 min).
CRON_VERIFICATION_SWEEPER=*/5 * * * *

# --- Roblox / RoProxy -----------------------------------------
ROBLOX_REQUEST_TIMEOUT_MS=10000
ROBLOX_MAX_RETRIES=2

# --- Platform health endpoint ---------------------------------
# HTTP port for GET /healthz (200 = Discord connected + DB reachable).
# 0 = disabled. Default 3000; set 0 for local development if the port is taken.
HEALTH_PORT=3000
