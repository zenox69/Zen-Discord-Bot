{
  "name": "zen-marketplace-bot",
  "version": "1.0.0",
  "description": "Production-ready Discord marketplace and order-management bot for Roblox communities",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "bot": "tsx scripts/runBot.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "tsx scripts/deployCommands.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:start": "tsx scripts/devDb.ts",
    "db:stop": "taskkill /F /IM postgres.exe /T 2>nul & echo stopped",
    "db:inspect": "tsx scripts/inspectDb.ts",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stopDev.ps1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "prisma": "^6.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.11"
  }
}
